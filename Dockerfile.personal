FROM python:3.14-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home jg && mkdir /data && chown jg /data
COPY jg ./jg
COPY fixtures ./fixtures
USER jg
ENV JG_DATABASE=/data/personal.db ENABLE_OPENAI=false
EXPOSE 8765
CMD ["python", "-m", "uvicorn", "jg.personal:app", "--factory", "--host", "0.0.0.0", "--port", "8765", "--workers", "1"]
